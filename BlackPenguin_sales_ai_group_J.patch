+import '@angular/compiler';
+import { of,Subject,throwError } from 'rxjs';
+import { describe,it,expect,vi,afterEach } from 'vitest';
+import { AgentContextComponent } from './agent-context';
+
+afterEach(()=>vi.useRealTimers());
+describe('Operational context',()=>{
+  it('clears old state and ignores late responses after selecting another conversation',()=>{
+    vi.useFakeTimers();const a=new Subject<any>(),b=new Subject<any>();let count=0;
+    const component=new AgentContextComponent({get:vi.fn(()=>++count===1?a:b)} as any);
+    component.conversationId='a';component.ngOnChanges();expect(component.loading).toBe(true);
+    component.conversationId='b';component.ngOnChanges();a.next({current_interest:{property:'Wrong'}});b.next({current_interest:{property:'Correct'}});
+    expect(component.data.current_interest.property).toBe('Correct');expect(component.loading).toBe(false);component.ngOnDestroy();
+  });
+  it('shows a diagnostic error and can refresh after a failed request',()=>{
+    vi.useFakeTimers();const get=vi.fn().mockReturnValueOnce(throwError(()=>new Error('HTTP failed'))).mockReturnValue(of({chat:{status:'open'}}));
+    const component=new AgentContextComponent({get} as any);component.conversationId='c';component.ngOnChanges();expect(component.error).toContain('could not be loaded');
+    component.refresh();expect(component.data.chat.status).toBe('open');expect(component.error).toBe('');component.ngOnDestroy();
+  });
+  it('does not expose retries for restricted or read only context',()=>{
+    const component=new AgentContextComponent({} as any);component.conversationId='c';component.data={scope_limited:true};component.canManage=true;
+    expect(component.canRetry({status:'review'})).toBe(false);component.data={scope_limited:false};component.canManage=false;expect(component.canRetry({status:'review'})).toBe(false);
+  });
+  it('requires an explanation and uses the owning replacement operation',()=>{
+    vi.useFakeTimers();const post=vi.fn(()=>of({status:'queued_for_recheck'})),get=vi.fn(()=>of({scope_limited:false}));
+    const component=new AgentContextComponent({get,post} as any);component.conversationId='c';component.canManage=true;component.ngOnChanges();
+    component.retry({id:'op',kind:'replacement_calendar',status:'review'});expect(post).not.toHaveBeenCalled();
+    component.note='Reviewed provider binding';component.retry({id:'op',kind:'replacement_calendar',status:'review'});
+    expect(post).toHaveBeenCalledWith(expect.stringContaining('/conversations/c/effects/retry'),{kind:'replacement',operation_id:'op',note:'Reviewed provider binding'});
+    expect(component.notice).toContain('does not mean synchronization has succeeded');component.ngOnDestroy();
+  });
+  it('uses the meeting endpoint for Schedule and makes timestamps explicitly UTC',()=>{
+    vi.useFakeTimers();const get=vi.fn(()=>of({scope_limited:true}));const component=new AgentContextComponent({get} as any);component.meetingId='m';component.ngOnChanges();
+    expect(get).toHaveBeenCalledWith(expect.stringContaining('/meetings/m/operational-context'));
+    expect(component.utc('2026-11-08T20:00:00')).toBe('2026-11-08T20:00:00Z');expect(component.utc('2026-11-08T20:00:00-05:00')).toContain('-05:00');component.ngOnDestroy();
+  });
+});
diff --git a/frontend/src/app/shared/ui/agent-context/agent-context.ts b/frontend/src/app/shared/ui/agent-context/agent-context.ts
new file mode 100644
index 0000000..63c0bef
--- /dev/null
+++ b/frontend/src/app/shared/ui/agent-context/agent-context.ts
@@ -0,0 +1,42 @@
+import { CommonModule } from '@angular/common';
+import { ChangeDetectorRef, Component, Input, OnChanges, OnDestroy } from '@angular/core';
+import { FormsModule } from '@angular/forms';
+import { HttpClient } from '@angular/common/http';
+import { Subscription } from 'rxjs';
+import { API_V1_URL } from '../../../core/config/api.config';
+
+@Component({selector:'app-agent-context',standalone:true,imports:[CommonModule,FormsModule],
+  templateUrl:'./agent-context.html',styleUrl:'./agent-context.scss'})
+export class AgentContextComponent implements OnChanges,OnDestroy {
+  @Input() conversationId='';
+  @Input() meetingId='';
+  @Input() context:any=null;
+  @Input() canManage=false;
+  data:any=null;error='';notice='';loading=false;retrying=false;note='';
+  private generation=0;private request?:Subscription;private action?:Subscription;private timer?:ReturnType<typeof setInterval>;
+  constructor(private http:HttpClient,private cdr?:ChangeDetectorRef){}
+  ngOnChanges():void {
+    this.generation++;this.request?.unsubscribe();this.action?.unsubscribe();if(this.timer)clearInterval(this.timer);
+    this.data=this.context;this.error='';this.notice='';this.note='';this.retrying=false;this.loading=false;
+    if(!this.context&&(this.conversationId||this.meetingId)){this.refresh();this.timer=setInterval(()=>this.refresh(),10000);}
+  }
+  ngOnDestroy():void{this.generation++;this.request?.unsubscribe();this.action?.unsubscribe();if(this.timer)clearInterval(this.timer);}
+  refresh():void{
+    if(this.context||(!this.conversationId&&!this.meetingId)||this.loading)return;
+    this.loading=true;const version=this.generation;
+    const path=this.meetingId?`meetings/${encodeURIComponent(this.meetingId)}`:`conversations/${encodeURIComponent(this.conversationId)}`;
+    this.request=this.http.get<any>(`${API_V1_URL}/sales-agent/${path}/operational-context`).subscribe({next:d=>{
+      if(version!==this.generation)return;this.data=d;this.loading=false;this.error='';this.cdr?.markForCheck();
+    },error:()=>{if(version!==this.generation)return;this.loading=false;this.error='Context could not be loaded. Check access and refresh.';this.cdr?.markForCheck();}});
+  }
+  utc(value:string|undefined):string|undefined{return value&&!/[zZ]$|[+-]\d\d:\d\d$/.test(value)?value+'Z':value;}
+  label(value:any):string{return String(value||'unknown').replaceAll('_',' ');}
+  canRetry(effect:any):boolean{return this.canManage&&!this.data?.scope_limited&&!!this.conversationId&&['review','retry','failed','waiting_connection','waiting_new_calendar','waiting_old_connection','pending'].includes(effect.status);}
+  retry(effect:any):void{
+    if(!this.canRetry(effect)||this.retrying||this.note.trim().length<3)return;
+    const kind=effect.kind==='replacement_calendar'?'replacement':effect.kind.startsWith('cancellation_')?'cancellation':'booking';
+    const version=this.generation;this.retrying=true;this.error='';
+    this.action=this.http.post(`${API_V1_URL}/sales-agent/conversations/${encodeURIComponent(this.conversationId)}/effects/retry`,{
+      kind,operation_id:effect.id,note:this.note.trim()}).subscribe({next:()=>{if(version!==this.generation)return;this.retrying=false;this.notice='Queued for recheck. A retry does not mean synchronization has succeeded.';this.refresh();this.cdr?.markForCheck();},error:()=>{if(version!==this.generation)return;this.retrying=false;this.error='The effect could not be retried. Refresh and review its current state or permissions.';this.cdr?.markForCheck();}});
+  }
+}
