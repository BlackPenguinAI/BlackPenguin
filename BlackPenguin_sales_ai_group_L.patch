diff --git a/frontend/tools/release-stamp.cjs b/frontend/tools/release-stamp.cjs
new file mode 100644
index 0000000..7b0765f
--- /dev/null
+++ b/frontend/tools/release-stamp.cjs
@@ -0,0 +1,17 @@
+// Public build identity only. No environment values other than the commit are exported.
+const fs=require('node:fs');const path=require('node:path');const crypto=require('node:crypto');
+function stamp(root,commit='unknown') {
+ if(commit!=='unknown'&&!/^[0-9a-f]{40}$/.test(commit))throw Error('Use a full lowercase Git SHA or unknown');
+ if(!fs.existsSync(path.join(root,'index.html')))throw Error('Build index.html is missing');
+ const files=[];
+ function walk(dir){for(const entry of fs.readdirSync(dir,{withFileTypes:true}).sort((a,b)=>a.name<b.name?-1:a.name>b.name?1:0)){
+  const file=path.join(dir,entry.name);if(entry.isSymbolicLink())throw Error('Build symlinks are not supported');
+  if(entry.isDirectory())walk(file);else if(entry.isFile()&&file!==path.join(root,'release.json'))files.push(file);
+ }}walk(root);
+ const hash=crypto.createHash('sha256');
+ for(const file of files){hash.update(path.relative(root,file).split(path.sep).join('/'));hash.update('\0');hash.update(crypto.createHash('sha256').update(fs.readFileSync(file)).digest());}
+ const result={version:'blackpenguin.frontend-release/1.0',service:'frontend',commit,commit_known:commit!=='unknown',assets_sha256:hash.digest('hex'),asset_count:files.length};
+ fs.writeFileSync(path.join(root,'release.json'),JSON.stringify(result,null,2)+'\n');return result;
+}
+if(require.main===module){const root=path.resolve(__dirname,'../dist/frontend/browser');console.log(JSON.stringify(stamp(root,process.env.APP_COMMIT_SHA||'unknown')));}
+module.exports={stamp};
diff --git a/frontend/tools/release-stamp.test.cjs b/frontend/tools/release-stamp.test.cjs
new file mode 100644
index 0000000..d06548b
--- /dev/null
+++ b/frontend/tools/release-stamp.test.cjs
@@ -0,0 +1,7 @@
+const {test}=require('node:test');const assert=require('node:assert/strict');const fs=require('node:fs');const os=require('node:os');const path=require('node:path');const {stamp}=require('./release-stamp.cjs');
+function fixture(t){const dir=fs.mkdtempSync(path.join(os.tmpdir(),'bp-release-'));t.after(()=>fs.rmSync(dir,{recursive:true,force:true}));fs.writeFileSync(path.join(dir,'index.html'),'<app-root></app-root>');fs.writeFileSync(path.join(dir,'main.js'),'console.log("synthetic")');return dir;}
+test('stamps the exact commit and stable public asset digest',t=>{const dir=fixture(t);const result=stamp(dir,'a'.repeat(40));assert.equal(result.commit_known,true);assert.equal(result.asset_count,2);assert.deepEqual(stamp(dir,'a'.repeat(40)),result);fs.appendFileSync(path.join(dir,'main.js'),' ');assert.notEqual(stamp(dir,'a'.repeat(40)).assets_sha256,result.assets_sha256);});
+test('unknown local builds never claim a verified commit',t=>{assert.equal(stamp(fixture(t)).commit_known,false);});
+test('rejects malformed commit values before writing a release file',t=>{const dir=fixture(t);assert.throws(()=>stamp(dir,'not a Git revision'));assert.equal(fs.existsSync(path.join(dir,'release.json')),false);});
+test('requires a completed build',t=>{const dir=fixture(t);fs.unlinkSync(path.join(dir,'index.html'));assert.throws(()=>stamp(dir,'a'.repeat(40)));});
+test('refuses symlinked files instead of hashing outside the build',t=>{const dir=fixture(t);fs.symlinkSync(__filename,path.join(dir,'linked.js'));assert.throws(()=>stamp(dir,'a'.repeat(40)));});
