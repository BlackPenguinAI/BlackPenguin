{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:onboarding": "ng test --watch=false --ts-config=tsconfig.onboarding-regression.json --include='src/app/pages/client/projects/project-chat/*-*.spec.ts' --exclude='**/project-chat.spec.ts' --include='src/app/pages/onboarding-*.spec.ts' --include='src/app/shared/ui/onboarding-*/*.spec.ts' --include='src/app/shared/ui/configure-later/*.spec.ts' --include='src/app/pages/client/marketing/*.spec.ts' --include='src/app/core/timezones.spec.ts'"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ng-select/ng-select": "^21.8.2",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "marked": "^18.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.17",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.0",
    "autoprefixer": "^10.5.2",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.16",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
