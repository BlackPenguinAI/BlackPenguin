# =================================================================
# Entorno de Ejecución
# =================================================================
ENVIRONMENT="local"

# =================================================================
# Seguridad y Autenticación (JWT)
# =================================================================
SECRET_KEY="insertar_secreto_aqui_no_usar_en_produccion"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =================================================================
# Bases de Datos
# =================================================================
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_bd"
# Required only when intentionally running the destructive local reset script.
ALLOW_DESTRUCTIVE_DB_RESET=false
MONGO_URL="mongodb://localhost:27017/nombre_bd"

# =================================================================
# Credenciales del Master Setup (Superadmin)
# =================================================================
FIRST_SUPERADMIN_EMAIL="superadmin@ejemplo.com"
FIRST_SUPERADMIN_PASSWORD="password_seguro_aqui"

# =================================================================
# Integraciones: Meta Graph API (Leadgen)
# =================================================================
META_ACCESS_TOKEN="tu_token_generado_en_business_manager"
META_APP_ID=""
META_LOGIN_CONFIG_ID=""
META_BUSINESS_MANAGER_ID=""
META_VERIFY_TOKEN="tu_token_de_verificacion_inventado"
META_APP_SECRET="tu_app_secret_de_meta_developers"
META_OAUTH_REDIRECT_URI="https://blackpenguin.ai/api/v1/projects/integrations/meta/oauth/callback"

# =================================================================
# Inteligencia Artificial (OpenRouter)
# =================================================================
OPENROUTER_API_KEY="sk-or-v1-tu_clave_api"
DEFAULT_AI_MODEL="deepseek/deepseek-chat"

# =================================================================
# Encrypted provider settings
# =================================================================
# Keep this value stable across deployments. Rotating it requires a controlled
# re-encryption of stored Twilio and Google credentials.
SETTINGS_ENCRYPTION_KEY="generate_a_long_random_production_secret"

# Optional bootstrap values. Superadmin can configure the same providers from
# the Black Penguin control panel; provider secrets are write-only.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE_NUMBER="+18573824206"
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="https://blackpenguin.ai/api/v1/sales/calendar/google/callback"
FIREBASE_PROJECT_ID=""
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
