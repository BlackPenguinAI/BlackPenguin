# =================================================================
# Entorno de Ejecución
# =================================================================
ENVIRONMENT="local"

# =================================================================
# Seguridad y Autenticación (JWT)
# =================================================================
SECRET_KEY="insertar_secreto_aqui_no_usar_en_produccion"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =================================================================
# Bases de Datos
# =================================================================
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_bd"
# Required only when intentionally running the destructive local reset script.
ALLOW_DESTRUCTIVE_DB_RESET=false
MONGO_URL="mongodb://localhost:27017/nombre_bd"

# =================================================================
# Credenciales del Master Setup (Superadmin)
# =================================================================
FIRST_SUPERADMIN_EMAIL="superadmin@ejemplo.com"
FIRST_SUPERADMIN_PASSWORD="password_seguro_aqui"

# =================================================================
# Integraciones: Meta Graph API (Leadgen)
# =================================================================
META_ACCESS_TOKEN="tu_token_generado_en_business_manager"
META_VERIFY_TOKEN="tu_token_de_verificacion_inventado"
META_APP_SECRET="tu_app_secret_de_meta_developers"

# =================================================================
# Inteligencia Artificial (OpenRouter)
# =================================================================
OPENROUTER_API_KEY="sk-or-v1-tu_clave_api"
DEFAULT_AI_MODEL="deepseek/deepseek-chat"
