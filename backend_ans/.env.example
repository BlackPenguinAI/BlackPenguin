# Entorno de Ejecución
ENVIRONMENT="local"

# Seguridad JWT (No será la misma clave en DigitalOcean, se generará una nueva)
SECRET_KEY="BLACK_PENGUIN_SUPER_SECRET_KEY_FOR_LOCAL_SIGNING_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base de Datos PostgreSQL Local
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL="postgresql://postgres:1234@localhost:5432/blackpenguin_db"

# Credenciales del Superadmin Inicial (Master Setup)
FIRST_SUPERADMIN_EMAIL="superadmin@blackpenguin.ai"
FIRST_SUPERADMIN_PASSWORD="superadmin1234"

# Credenciales de Meta
META_ACCESS_TOKEN="token_de_prueba_pendiente"
META_VERIFY_TOKEN="blackpenguin_meta_token_2026"
META_APP_SECRET="app_secret_de_meta_pendiente"